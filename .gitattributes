# Normalize line endings: LF in the repository, native in the working copy.
* text=auto eol=lf

# Scripts and Makefiles MUST be LF or they break on Unix/CI.
*.sh    text eol=lf
Makefile text eol=lf
*.mk    text eol=lf

# Windows-only scripts stay CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets.
*.png   binary
*.jpg   binary
*.pdf   binary
